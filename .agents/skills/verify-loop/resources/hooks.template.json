{
  "verify-loop-commit-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"/absolute/path/to/trusted/verify-loop/scripts/commit_gate_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
